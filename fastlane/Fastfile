default_platform(:ios)

platform :ios do
  desc "Build and deploy to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: "AuthKey.p8",
      in_house: false
    )

    keychain_path = File.expand_path("~/Library/Keychains/ci_keychain-db")
    if !File.exist?(keychain_path)
      create_keychain(
        name: "ci_keychain",
        password: "ci_keychain_password",
        default_keychain: true,
        unlock: true,
        timeout: 3600
      )
    else
      sh("security unlock-keychain -p ci_keychain_password #{keychain_path}")
      sh("security default-keychain -s #{keychain_path}")
      sh("security list-keychains -s #{keychain_path}")
    end

    begin
      get_certificates(
        api_key: api_key,
        keychain_path: "~/Library/Keychains/ci_keychain-db",
        keychain_password: "ci_keychain_password"
      )
    rescue => ex
      UI.error("Failed to get certificates: #{ex.message}")
      UI.message("Attempting to clean up old certificates...")
      require 'spaceship'
      certs = Spaceship::ConnectAPI::Certificate.all
      dist_cert = certs.find { |c| c.certificate_type.include?("DISTRIBUTION") }
      if dist_cert
        dist_cert.delete!
        UI.message("Deleted distribution certificate #{dist_cert.id}")
      end
      get_certificates(
        api_key: api_key,
        keychain_path: "~/Library/Keychains/ci_keychain-db",
        keychain_password: "ci_keychain_password"
      )
    end

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.sprintflow.inc"
    )

    profile_path = Actions.lane_context[SharedValues::SIGH_PROFILE_PATH]
    team_id = sh("security cms -D -i \"#{profile_path}\" | plutil -extract TeamIdentifier.0 raw -").strip
    profile_name = Actions.lane_context[SharedValues::SIGH_NAME]

    # Force manual signing directly in the pbxproj to prevent Xcode 14+ conflicting settings error
    project_path = Dir.glob("ios/*.xcodeproj").first
    update_code_signing_settings(
      use_automatic_signing: false,
      path: project_path
    )

    build_app(
      workspace: "ios/Sprintflow.xcworkspace",
      scheme: "Sprintflow",
      export_method: "app-store",
      export_options: {
        teamID: team_id,
        provisioningProfiles: {
          "com.sprintflow.inc" => profile_name
        }
      },
      xcargs: "CODE_SIGNING_STYLE=Manual DEVELOPMENT_TEAM='#{team_id}' PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'",
      output_directory: "./build",
      output_name: "Sprintflow.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
