{
  "expo": {
    "name": "Sprintflow",
    "slug": "sprintflow-v2",
    "scheme": "sprintflowv2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "automatic",
      "bundleIdentifier": "com.sprintflow.inc",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050505"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sprintflow.inc",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Sprintflow a besoin de l'appareil photo pour scanner les codes-barres des aliments."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Sprintflow a besoin de votre localisation pour vous fournir la météo de votre lieu d'entraînement."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sprintflow a besoin d'accéder à vos photos pour modifier votre photo de profil."
        }
      ]
    ]
  }
}